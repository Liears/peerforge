{
  "workdir": ".",
  "session_dir": ".peerforge/sessions",
  "runtime_dir": ".peerforge/runtime",
  "timeout_seconds": 10,
  "history_limit": 8,
  "agents": [
    {
      "name": "alpha",
      "type": "command",
      "enabled": true,
      "command": [
        "python3",
        "{workdir}/peerforge/mock_peer.py",
        "alpha",
        "{prompt}"
      ]
    },
    {
      "name": "beta",
      "type": "command",
      "enabled": true,
      "command": [
        "python3",
        "{workdir}/peerforge/mock_peer.py",
        "beta",
        "{prompt}"
      ]
    }
  ]
}
